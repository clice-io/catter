module(name = "catter")

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_pkg", version = "1.3.0")

# `bazel run @compdb//:refresh` writes compile_commands.json.
bazel_dep(name = "compdb", version = "0.1.0")

# kotatsu and the third-party libraries, as the clice Bazel registry
# (.bazelrc) packages them. kotatsu's version is 0.1.0.<n> for the n-th
# commit of its main.
bazel_dep(name = "kotatsu", version = "0.1.0.251")
bazel_dep(name = "cpptrace", version = "1.0.4.clice.1")
bazel_dep(name = "detours", version = "4.0.1.20260929.clice.1")
bazel_dep(name = "spdlog", version = "1.15.3.clice.1")

# The C++ toolchain on every platform and the option tables of
# src/command/option, both from one xclang release. pixi.toml pins the same
# release for the LLVM tools the artifact check runs.
bazel_dep(name = "xclang", version = "23.1.3.5")

xclang = use_extension("@xclang//bazel:extensions.bzl", "xclang")
use_repo(xclang, "llvm_option_inc")
