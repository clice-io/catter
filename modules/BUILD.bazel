load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:defs.bzl", "COPTS")
load(":modules.bzl", "LIBRARIES", "MODULE_COPTS")

# The third-party libraries as one named module over their headers, written
# by `clice modularize` once for each configuration CI builds and merged:
# deps.cppm includes the libraries' headers in its global module fragment,
# <configuration>/deps.fragment.h of the configuration whose condition
# holds, and exports what they declare. prelude.h, which every module unit
# of catter includes first (through src/support/prelude.h in the catter
# module), imports it and defines again the macros its headers define. scripts/modules.py writes all of it from demand.cpp;
# nothing it writes is edited by hand.

# The fragments, the macro headers and the preludes.
cc_library(
    name = "headers",
    textual_hdrs = glob(["**/*.h"]),
)

cc_library(
    name = "deps",
    copts = COPTS + MODULE_COPTS,
    features = ["cpp_modules"],
    module_interfaces = ["deps.cppm"],
    deps = [
        ":headers",
        "@xclang//bazel:std",
    ] + LIBRARIES,
)

cc_library(
    name = "modules",
    visibility = ["//:__pkg__"],
    deps = [":deps"],
)

# What catter takes from the libraries, the program scripts/modules.py
# indexes for each configuration to write the rest of modules/.
cc_library(
    name = "demand",
    srcs = ["demand.cpp"],
    copts = COPTS + MODULE_COPTS,
    tags = ["manual"],
    deps = LIBRARIES,
)
