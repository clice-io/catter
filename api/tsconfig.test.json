    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "./test",
        "outDir": "./output/test/",
        "declaration": false,
        "paths": {
            "catter/*": [
                "./output/types/*"
            ],
