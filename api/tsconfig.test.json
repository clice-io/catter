{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "./test",
        "outDir": "./output/test/",
        "declaration": false,
        "paths": {
            "catter/*": [
                "./output/types/*/index.d.ts",
                "./output/types/*.d.ts"
            ]
        }
    },
    "include": [
        "test/**/*.ts",
    ],
    "exclude": [
        "node_modules"
    ],
}
