{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "./src",
        "outDir": "./build/lib",
        "declaration": true,
        "declarationDir": "./build/types",
        "declarationMap": true,
        "sourceMap": true,
        "paths": {
            "catter/*": [
                "./src/*/index.ts",
                "./src/*.ts"
            ],
            "catter-c": [
                "./catter-c/capi.d.ts"
            ],
        }
    },
    "include": [
        "src/**/*.ts",
    ],
    "exclude": [
        "node_modules"
    ],
}
