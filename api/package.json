{
  "name": "catter",
  "version": "1.0.0",
  "author": "clice-io",
  "description": "Catter QuickJS runtime API types and editor hints.",
  "type": "module",
  "types": "./output/types/index.d.ts",
  "main": "./output/lib/catter.js",
  "exports": {
    ".": {
      "types": "./output/types/index.d.ts",
      "default": "./output/lib/catter.js"
    },
    "./*": {
      "types": "./output/types/catter/*.d.ts",
      "default": "./output/lib/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "catter": [
        "output/types/index.d.ts"
      ],
      "catter/*": [
        "output/types/catter/*"
      ]
    }
  },
  "files": [
    "output/lib",
    "output/types"
  ],
  "scripts": {
    "clean": "xmake l os.tryrm ./output ./build",
    "build:runtime": "xmake l os.tryrm ./output/lib && rollup -c ./rollup.config.js",
    "build:types": "xmake l os.tryrm ./output/types && node ./scripts/build-types.mjs",
    "build:tests": "xmake l os.tryrm ./output/test && tsc --project tsconfig.test.json",
    "build": "run-p build:runtime build:types",
    "test": "run-s build:types build:tests",
    "prepack": "pnpm run test",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.53.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
