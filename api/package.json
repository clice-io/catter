{
  "name": "catter",
  "version": "1.0.0",
  "author": "clice-io",
  "description": "Catter QuickJS runtime API types and editor hints.",
  "type": "module",
  "types": "./output/types/index.d.ts",
  "main": "./output/lib/catter.js",
  "exports": {
    ".": {
      "types": "./output/types/index.d.ts",
      "default": "./output/lib/catter.js"
    },
    "./*": {
      "types": "./output/types/catter/*.d.ts",
      "default": "./output/lib/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "catter": [
        "output/types/index.d.ts"
      ],
      "catter/*": [
        "output/types/catter/*"
      ]
    }
  },
  "files": [
    "output/lib",
    "output/types"
  ],
  "scripts": {
    "rm": "xmake l os.tryrm",
    "clean:lib": "pnpm run rm -- ./build/lib ./output/lib",
    "clean:types": "pnpm run rm -- ./output/types ./build/types",
    "clean:tests": "pnpm run rm -- ./output/test",
    "clean": "pnpm run rm -- ./output ./build",
    "compile:js": "tsc --project tsconfig.app.json --declaration false --declarationDir null --declarationMap false",
    "compile:types": "tsc --project tsconfig.app.json --emitDeclarationOnly",
    "compile:test": "tsc --project tsconfig.test.json",
    "compile": "tsc --project tsconfig.app.json",
    "package:runtime": "rollup -c ./rollup.config.js",
    "package:types": "node ./scripts/build-types.mjs",
    "build:runtime": "run-s clean:lib compile:js package:runtime",
    "build:types": "run-s clean:types compile:types package:types",
    "build:tests": "run-s clean:tests compile:test",
    "build": "run-s clean compile && run-p package:runtime package:types && run-s compile:test"
  },
  "keywords": [],
  "license": "Apache-2.0",
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "@rollup/plugin-terser": "^0.4.4",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.53.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
