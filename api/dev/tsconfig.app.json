{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "../src",
        "outDir": "../build/lib",
        "declaration": true,
        "declarationDir": "../types",
        "declarationMap": true,
        "sourceMap": true,
        "paths": {
            "catter/native": [
                "../native/index.d.ts"
            ],
            "catter/*": [
                "../src/*/index.ts",
                "../src/*.ts"
            ]
        }
    },
    "include": [
        "../src/**/*.ts",
    ],
    "exclude": [
        "node_modules"
    ],
}
