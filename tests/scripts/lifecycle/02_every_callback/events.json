{
  "version": 1,
  "name": "a build whose commands print, fail, and are not captured",
  "events": [
    {
      "type": "command",
      "id": 1,
      "exe": "make",
      "argv": ["make", "all"]
    },
    {
      "type": "command",
      "id": 2,
      "parent": 1,
      "exe": "cc",
      "argv": ["cc", "-c", "a.c"],
      "execution": {
        "code": 1,
        "stdout": "from cc\n",
        "stderr": "a.c: error\n"
      }
    },
    {
      "type": "command",
      "id": 3,
      "exe": "",
      "argv": [],
      "error": {
        "message": "could not capture",
        "parent": 1
      }
    }
  ],
  "finish": {
    "code": 2,
    "stdout": "make output\n",
    "stderr": "make: *** [all] Error 1\n"
  }
}
