REQUIRES: make
XFAIL: system-darwin

make -j8 over 100 sources, compiled by make directly; every source gets an
entry.

RUN: %e2e generate 100 %t
RUN: cd %t && %catter script::cdb -q -o %t/compile_commands.json -- make -j8
RUN: %e2e summarize --brief %t/compile_commands.json %t | FileCheck %s

CHECK: entries: 100
CHECK-NEXT: other entries: 0
CHECK-NEXT: missing sources: 0
CHECK-NEXT: without define: 0
CHECK-NEXT: unexpanded response files: 0
