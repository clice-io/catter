REQUIRES: cmake-ninja
XFAIL: system-darwin, system-windows

script::target-tree shows the executable of a real build with the objects
and sources it is made of.
Known failures: #115 on macOS and #123 on Windows (link.exe takes its objects from a response file).

RUN: %e2e prepare hello %t
RUN: cmake -S %t -B %t/build -G Ninja
RUN: %catter script::target-tree -- cmake --build %t/build | FileCheck %s

CHECK: Linking {{.*}}executable hello
CHECK-NEXT: hello
CHECK-DAG: main.cc.{{o|obj}}
CHECK-DAG: util.cc.{{o|obj}}
