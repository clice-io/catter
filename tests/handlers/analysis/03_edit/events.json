{
  "version": 1,
  "name": "commands a handler edits the arguments of",
  "events": [
    { "type": "command", "id": 1, "exe": "make", "argv": ["make"] },
    {
      "type": "command",
      "id": 2,
      "parent": 1,
      "exe": "gcc",
      "argv": ["gcc", "-msmall-data-limit=8", "-DOLD", "-Wall", "-Wextra", "-Wl,--as-needed", "-I", "include", "-c", "a.c", "-o", "a.o"]
    },
    { "type": "command", "id": 3, "parent": 1, "exe": "cl", "argv": ["cl", "/nologo", "/W3", "/c", "b.c", "/link", "/dll"] },
    { "type": "command", "id": 4, "parent": 1, "exe": "ld.lld", "argv": ["ld.lld", "-o", "app", "a.o", "-lm"] },
    { "type": "command", "id": 5, "parent": 1, "exe": "clang", "argv": ["clang", "-c", "--", "c.c"] }
  ]
}
