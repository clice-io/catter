{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./build",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "catter": [
        "../api/output/types/index.d.ts"
      ],
      "catter/*": [
        "../api/output/types/catter/*.d.ts"
      ],
      "catter-c": [
        "../api/catter-c/capi.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
